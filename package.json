{
  "name": "wxo-starter-kit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The watsonx Orchestrate Starter Kit \u2014 a friendly, premium guide to the full agentic AI development lifecycle.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
